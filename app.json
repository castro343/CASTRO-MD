{
  "name": "CASTRO-MD",
  "description": "CASTRO-MD WhatsApp automation bot by Castro",
  "repository": "https://github.com/castro343/CASTRO-MD",
  "keywords": [
    "whatsapp",
    "bot",
    "nodejs",
    "castro-md"
  ],
  "stack": "container",
  "env": {
    "SESSION_ID": {
      "description": "Session ID from the /pair page (starts with CASTRO-MD~)",
      "required": false
    },
    "OWNER_NUMBER": {
      "description": "Additional owner numbers (digits only, country code included). Castro is the primary owner.",
      "value": "254739082713",
      "required": false
    },
    "SESSION_DIR": {
      "value": "/tmp/session"
    },
    "BOT_NAME": {
      "value": "CASTRO-MD"
    },
    "PREFIX": {
      "value": "."
    },
    "MODE": {
      "value": "public"
    },
    "TIMEZONE": {
      "value": "Africa/Nairobi"
    },
    "AUTO_VIEW_STATUS": {
      "value": "true"
    },
    "CONNECT_ALERT": {
      "value": "true"
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  }
}
